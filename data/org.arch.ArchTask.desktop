#!/usr/bin/env xdg-open
[Desktop Entry]
Name=ArchTask
GenericName=System Task Manager
Comment=Native, high-performance system monitor and task manager for Arch Linux
Exec=arch-task
Icon=org.arch.ArchTask
Terminal=false
Type=Application
Categories=System;Monitor;GTK;
Keywords=task;manager;process;cpu;memory;performance;systemd;network;monitor;
StartupNotify=true
